# Supabase Config
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Zoho Payments API Credentials
NEXT_PUBLIC_ZOHO_PAYMENTS_CLIENT_ID=your_zoho_client_id
ZOHO_PAYMENTS_CLIENT_SECRET=your_zoho_client_secret
ZOHO_PAYMENTS_ACCOUNT_ID=your_zoho_account_id
ZOHO_PAYMENTS_WEBHOOK_SECRET=your_zoho_webhook_secret

# Razorpay Payment Keys (Alternative option)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_phrase

# Application Domain Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
